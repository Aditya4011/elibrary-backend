# Copy this file to .env and fill in real values before deploying.

# Port the server listens on
PORT=4000

# Secret used to sign login tokens (JWT). Use a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Where the SQLite database file is stored. Leave unset to use ./data/elibrary.sqlite
# DB_PATH=/absolute/path/to/elibrary.sqlite

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@stackroom.local
SEED_ADMIN_PASSWORD=admin123
